extends base

block  head
  link(href='https://api.mapbox.com/mapbox-gl-js/v3.28.1/mapbox-gl.css' rel='stylesheet')

block content
  - const startDate = tour.startDates && tour.startDates.length ? tour.startDates[0].toLocaleString('en-us', { month: 'long', year: 'numeric' }) : 'Coming soon';
  - const descriptionParts = tour.description ? tour.description.split('\n').filter(Boolean) : [];
  - const guideRole = index => index === 0 ? 'Lead guide' : 'Tour guide';

  section.section-header
    .header__hero
      .header__hero-overlay &nbsp;
      img.header__hero-img(src=`/img/tours/${tour.imageCover}` alt=tour.name)
    .heading-box
      h1.heading-primary
        span= tour.name
      .heading-box__group
        .heading-box__detail
          svg.heading-box__icon
            use(xlink:href='/img/icons.svg#icon-clock')
          span.heading-box__text #{tour.duration} days
        .heading-box__detail
          svg.heading-box__icon
            use(xlink:href='/img/icons.svg#icon-map-pin')
          span.heading-box__text= tour.startLocation.description

  section.section-description
    .overview-box
      div
        .overview-box__group
          h2.heading-secondary.ma-bt-lg Quick facts
          .overview-box__detail
            svg.overview-box__icon
              use(xlink:href='/img/icons.svg#icon-calendar')
            span.overview-box__label Next date
            span.overview-box__text= startDate
          .overview-box__detail
            svg.overview-box__icon
              use(xlink:href='/img/icons.svg#icon-trending-up')
            span.overview-box__label Difficulty
            span.overview-box__text= tour.difficulty
          .overview-box__detail
            svg.overview-box__icon
              use(xlink:href='/img/icons.svg#icon-user')
            span.overview-box__label Participants
            span.overview-box__text #{tour.maxGroupSize} people
          .overview-box__detail
            svg.overview-box__icon
              use(xlink:href='/img/icons.svg#icon-star')
            span.overview-box__label Rating
            span.overview-box__text #{tour.ratingsAverage} / 5

        if tour.guides.length
          .overview-box__group
            h2.heading-secondary.ma-bt-lg Your tour guides
            each guide, index in tour.guides
              .overview-box__detail
                img.overview-box__img(src=`/img/users/${guide.photo}` alt=guide.name)
                span.overview-box__label= guideRole(index)
                span.overview-box__text= guide.name

    .description-box
      h2.heading-secondary.ma-bt-lg About #{tour.name}
      if descriptionParts.length
        each paragraph in descriptionParts
          p.description__text= paragraph
      else
        p.description__text= tour.summary

  if tour.images.length
    section.section-pictures
      each image, index in tour.images.slice(0, 3)
        .picture-box
          img.picture-box__img(class=`picture-box__img--${index + 1}` src=`/img/tours/${image}` alt=`${tour.name} ${index + 1}`)

  if tour.locations.length
    section.section-map
      #map(data-locations=`${JSON.stringify(tour.locations)}` data-mapbox-token=mapboxAccessToken)

  if tour.reviews.length
    section.section-reviews
      .reviews
        each review in tour.reviews
          .reviews__card
            .reviews__avatar
              img.reviews__avatar-img(src=`/img/users/${review.user.photo}` alt=review.user.name)
              h6.reviews__user= review.user.name
            p.reviews__text= review.review
            .reviews__rating
              each star in [1, 2, 3, 4, 5]
                svg.reviews__star(class=star <= review.rating ? 'reviews__star--active' : 'reviews__star--inactive')
                  use(xlink:href='/img/icons.svg#icon-star')

  section.section-cta
    .cta
      .cta__img.cta__img--logo
        img(src='/img/logo-white.png' alt='Natours logo')
      if tour.images[1]
        img.cta__img.cta__img--1(src=`/img/tours/${tour.images[1]}` alt='')
      if tour.images[0]
        img.cta__img.cta__img--2(src=`/img/tours/${tour.images[0]}` alt='')
      .cta__content
        h2.heading-secondary What are you waiting for?
        p.cta__text
          | #{tour.duration} days. 1 adventure. Infinite memories. Make it yours today!
        if user
              button.btn.btn--green.span-all-rows#book-tour(data-tourid=tour.id) Book tour now!
        else 
              a.btn.btn--green.span-all-rows(href='/login') Log in to book tour


block append scripts
  script(src='https://api.mapbox.com/mapbox-gl-js/v3.28.1/mapbox-gl.js')

